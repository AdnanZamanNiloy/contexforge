# Visual-testing artifacts (screenshots + harness scripts)
frontend/scripts/
frontend/*.png

# Upstream GitDiagram clone, kept locally as a design reference only.  Its
# path-validation rules, Mermaid compiler and prompt guidance were reimplemented
# in backend/app/architecture/; none of its Next.js code is part of this app.
/gitdiagram/

# Upstream semgrep CLI clone (its own repo, ~700MB).  Local tooling only — the
# app does not import it and no part of it belongs in this repository.
/semgrep/

# Upstream stack-analyser clone (its own repo, ~8MB).  Read as a design
# reference for the manifest parsers and detection model in
# backend/app/techstack/; none of its TypeScript is part of this app.
/stack-analyser/

# Upstream hotspots clone (its own repo, ~13MB).  Read as the source of the
# Local Risk Score formula and the per-function metric definitions ported into
# backend/app/health/; none of its Rust is part of this app.
/hotspots/
