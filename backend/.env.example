# ---------------------------------------------------------------------------
# ContextForge backend — environment template
#
# Copy this file to `.env` and fill in your own values. NEVER commit a real
# `.env` — it is git-ignored. All secrets default to empty; the app fails
# loudly at startup if a required provider key is missing.
# ---------------------------------------------------------------------------

# --- Required: embedding (enables ingestion + retrieval) ---
# Get a key at https://docs.voyageai.com and set VOYAGE_MODEL you can access.
VOYAGE_API_KEY=

# --- Required: at least one LLM provider (enables answer generation) ---
# Gemini (https://aistudio.google.com)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Optional: free-tier aggregator providers (added to fallback chain only when key is set) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free

CEREBRAS_API_KEY=
CEREBRAS_MODEL=gemma-4-31b

NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --- Optional: observability (Langfuse); leave blank to skip tracing ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Feature flags ---
# HyDE adds an LLM generation before retrieval; off by default.
USE_HYDE=false
# Wipe the knowledge base on startup.
CLEAR_ON_START=false

# --- Retrieval tuning ---
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
MAX_CHUNKS=20

# --- YouTube transcript ingestion ---
# YouTube blocks most cloud-provider IP ranges. Set a residential/rotating
# proxy (e.g. http://user:pass@host:port) to route YouTube transcript requests
# and work around the IP ban. Leave blank to use the direct connection.
YOUTUBE_PROXY=

# --- CORS: comma-separated explicit origins (never wildcard with credentials) ---
# ALLOWED_ORIGINS=["http://localhost:5173"]

# --- Logging: DEBUG | INFO | WARNING | ERROR ---
LOG_LEVEL=INFO
