# ---------------------------------------------------------------------------
# ContextForge backend — environment template
#
# Copy this file to `.env` and fill in your own values. NEVER commit a real
# `.env` — it is git-ignored.
#
# LLM and embedding API keys are NOT set here. Add them in the app instead:
# Model Center → add a model → paste its key → save. Keys are stored encrypted
# and handed to the provider at call time, so nothing provider-related belongs
# in this file.
#
# With no model registered the app still starts and every screen loads; only
# asking a question fails, and it names the model that needs a key.
# ---------------------------------------------------------------------------

# --- Optional: observability (Langfuse); leave blank to skip tracing ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Feature flags ---
# HyDE adds an LLM generation before retrieval; off by default.
USE_HYDE=false
# Wipe the knowledge base on startup.
CLEAR_ON_START=false

# --- Retrieval tuning ---
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5

# --- Chunking ---
# These are the real controls for how documents are split.  There is no
# MAX_CHUNKS setting — an earlier version of this file listed one and setting it
# did nothing, because nothing read it.  Retrieval limits above are per query;
# these are per document.
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# --- YouTube transcript ingestion ---
# YouTube blocks most cloud-provider IP ranges. Set a residential/rotating
# proxy (e.g. http://user:pass@host:port) to route YouTube transcript requests
# and work around the IP ban. Leave blank to use the direct connection.
YOUTUBE_PROXY=

# --- CORS: comma-separated explicit origins (never wildcard with credentials) ---
# ALLOWED_ORIGINS=["http://localhost:5173"]

# --- Model Hub: persisted model registry, fallback chains, serving selection ---
# Configured via the Model Hub UI. When a tier is left disabled, the
# environment-driven provider configuration above is used instead.
MODEL_HUB_DB_PATH=data/model_hub/model_hub.db

# Encrypts provider API keys you type into the Model Hub before they are written
# to MODEL_HUB_DB_PATH. Every other key here arrives via the environment and is
# never written down; the Model Hub is the one place the app persists a live
# credential, so without this a copy of backend/data/ is a set of working keys.
#
# Optional. Leave blank and the store keeps working exactly as before, logging a
# warning at startup. Keys already stored in plaintext stay readable either way —
# they are re-encrypted the next time each model is saved.
#
# Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Losing this key means stored API keys must be re-entered; the hub will report
# them as missing rather than failing requests at the provider.
CREDENTIAL_ENCRYPTION_KEY=

# --- Logging: DEBUG | INFO | WARNING | ERROR ---
LOG_LEVEL=INFO
