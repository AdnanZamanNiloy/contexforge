{
  // Cloudflare Workers config for the ContextForge demo.
  //
  // WITHOUT this file, `npx wrangler deploy` treats the repo as a plain Worker
  // and uploads the SOURCE tree (frontend/src/*.jsx, test/*) — which a browser
  // cannot run, producing a blank page. The `assets` block below serves the
  // BUILT bundle from deploy/dist, and `main` routes the two SPAs inside it.
  //
  // The build must run before deploy. It runs during install (see the root
  // package.json postinstall and deploy/ci-build.sh) and can also be run on its
  // own with `npm run build`.
  //
  // The name must match the Worker the CI project was created for, or Workers
  // Builds overrides it and opens a pull request to resolve the mismatch.
  "name": "contexforge",
  "main": "deploy/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    // The built static bundle: landing + workspace at the root, docs under
    // /docs. `deploy/worker.js` picks the shell when no file matches.
    "directory": "deploy/dist",
    "binding": "ASSETS",
    // Run the Worker on every request so it can choose between the app shell
    // and the docs shell. Without this, static assets are served first and a
    // deep /docs route that matches no file would never reach the Worker.
    "run_worker_first": true
  }
}
